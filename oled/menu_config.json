          "name": "Serial: Disable getty",
          "action": "{P4WN_HOME}/p4wnctl.py usb serial disable"
        },
        {
          "name": "Serial: Status",
          "status_cmd": "{P4WN_HOME}/p4wnctl.py usb serial status"
        },
