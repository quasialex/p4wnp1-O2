        {
          "name": "Show Status",
          "status_cmd": "{P4WN_HOME}/p4wnctl.py usb status"
        },
        {
          "name": "HID + NET (auto)",
          "action": "{P4WN_HOME}/p4wnctl.py usb set hid_net"
        },
        {
          "name": "HID + NET + MSD",
          "action": "{P4WN_HOME}/p4wnctl.py usb set hid_storage_net"
        },
        {
          "name": "HID + RNDIS",
          "action": "{P4WN_HOME}/p4wnctl.py usb set hid_rndis"
        },
        {
          "name": "HID + NCM",
          "action": "{P4WN_HOME}/p4wnctl.py usb set hid_ncm"
        },
        {
          "name": "HID + ECM",
          "action": "{P4WN_HOME}/p4wnctl.py usb set hid_ecm"
